# Optional. Everything has a safe default; Mock needs no tenant, no key and no network.
# These names are read from the shared settings file (~/Development/.env, or the file named by STANDALONE_ENV) and from the
# environment (the environment wins). Real is owner-run: agents never use a live gateway.
# PORT must be 7801 (this app's one allocated port).
PORT=7801
# PRIV_LOG_BIND=127.0.0.1   # loopback only unless you set this on purpose
# Real mode: the gateway's MCP endpoint (https, or http on loopback). The path /<app>/mcp is replaced per case when a case names an app.
# PRIV_LOG_GATEWAY_URL=https://gateway.example/demo-mcp-app/mcp
# An agent access key. WRITE-ONLY: never returned by any API, never logged, shown only as "Bearer ***".
# PRIV_LOG_AGENT_KEY=
# Optional: an Elasticsearch/OpenSearch-style endpoint to read log events back from (an origin, no path). Without it, paste log lines.
# PRIV_LOG_SEARCH_URL=https://search.example
# PRIV_LOG_SEARCH_INDEX=gateway-events
# Real mode, log source 1: a Kubernetes pod log through `kubectl proxy` (run it on this Mac: kubectl proxy). Loopback by default.
# PRIV_LOG_K8S_PROXY_URL=http://127.0.0.1:8001
# PRIV_LOG_K8S_NAMESPACE=privilege
# PRIV_LOG_K8S_POD=app=privilege-gateway      # a pod name, or a label selector
# PRIV_LOG_K8S_CONTAINER=log-tailer
# Per-case credentials for the not-yet-measured cases (write-only): PRIV_LOG_BEARER_<CASEID>, id upper-cased, - as _
# PRIV_LOG_BEARER_KEYS_REVOKED=
